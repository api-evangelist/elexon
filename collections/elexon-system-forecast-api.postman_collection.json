          "id": "968dcbd7-b51a-4578-946d-d0b7aaaf9592",
          "name": "Loss of load probability and de-rated margin forecast (LOLPDRM)",
          "request": {
            "name": "Loss of load probability and de-rated margin forecast (LOLPDRM)",
            "description": {
              "content": "This endpoint provides the 1h, 2h, 4h, 8h and 12h+ Loss of Load Probability and De-rated Margin forecasts\nfor each settlement period over a requested time range.\n            \nFor each forecast horizon at 1, 2, 4 or 8 hours, the returned value is the forecast received that number of hours\nbefore the start of the settlement period.\n            \nFor the forecast horizon of 12h, the returned value is the most recent forecast received 12 or more hours\nbefore the start of the settlement period. That is, if the most recent forecast was published today at 00:00,\n- for 11:30 today, the 12h forecast is the one published yesterday at 23:30 (12h before)\n- for 12:00 today, the 12h forecast is the one published today at 00:00 (12h before)\n- for 12:30 today, the 12h forecast is the one published today at 00:00 (the latest published)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "forecast",
                "system",
                "loss-of-load"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<dateTime>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "settlementPeriodFrom",
                  "value": "<integer>",
                  "description": "The \"from\" settlement period for the filter. This should be an integer from 1-50 inclusive."
                },
                {
                  "disabled": false,
                  "key": "settlementPeriodTo",
                  "value": "<integer>",
                  "description": "The \"to\" settlement period for the filter. This should be an integer from 1-50 inclusive."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response data format. Use json/xml to include metadata."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
