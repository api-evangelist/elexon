        {
          "id": "f21705ab-bc87-4d93-8eda-4adce6df3021",
          "name": "Market-wide bid-offer data (BOD)",
          "request": {
            "name": "Market-wide bid-offer data (BOD)",
            "description": {
              "content": "This endpoint provides market-wide bid-offer data, for all BMUs or a requested set of multiple BMUs.\nIt returns the data valid for a given settlement period, excluding any results where LevelFrom and LevelTo are both zero.\n            \nThe settlement period to query must be specified as a date and settlement period. The date should be provided in the format yyyy-MM-dd.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "balancing",
                "bid-offer",
                "all"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "settlementDate",
                  "value": "<date>",
                  "description": "(Required) The settlement date to filter."
                },
                {
                  "disabled": false,
                  "key": "settlementPeriod",
                  "value": "<integer>",
                  "description": "(Required) The settlement period to filter. This should be an integer from 1-50 inclusive."
                },
                {
                  "disabled": false,
                  "key": "bmUnit",
                  "value": "<string>",
                  "description": "The BM Units to query. Elexon or NGC BMU IDs can be used. If omitted, results for all BM units will be returned."
                },
                {
                  "disabled": false,
                  "key": "bmUnit",
                  "value": "<string>",
                  "description": "The BM Units to query. Elexon or NGC BMU IDs can be used. If omitted, results for all BM units will be returned."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response data format. Use json/xml to include metadata."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
