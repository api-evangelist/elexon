        {
          "id": "ce1ca957-2449-4b7b-8486-8afa42c5b8a8",
          "name": "Disaggregated balancing services adjustment per settlement period (DISBSAD)",
          "request": {
            "name": "Disaggregated balancing services adjustment per settlement period (DISBSAD)",
            "description": {
              "content": "This endpoint provides disaggregated balancing services adjustment data for a single settlement period. The\nresponse includes all the buying and selling actions that occurred during that settlement period.\n            \nDate parameter must be provided in the exact format yyyy-MM-dd.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "balancing",
                "nonbm",
                "disbsad",
                "details"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "settlementDate",
                  "value": "<date>",
                  "description": "(Required) The settlement date to query."
                },
                {
                  "disabled": false,
                  "key": "settlementPeriod",
                  "value": "<integer>",
                  "description": "(Required) The settlement period to query. This should be an integer from 1-50 inclusive."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response data format. Use json/xml to include metadata."
