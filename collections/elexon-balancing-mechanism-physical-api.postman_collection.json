        {
          "id": "a670b5a7-b7dd-4c49-bbaf-bb3a79ca5ae0",
          "name": "Market-wide physical data (PN, QPN, MILS, MELS)",
          "request": {
            "name": "Market-wide physical data (PN, QPN, MILS, MELS)",
            "description": {
              "content": "This endpoint provides the physical data for multiple requested BMUs or all BMUs.\nIt returns the data valid for a single settlement period.\n            \nOnly one dataset can be queried at a time: PN, QPN, MILS, or MELS.\nThe results from each dataset are transformed to a common response model, with fields not present in all 4 datasets dropped.\n            \nThe settlement period to query must be specified as a date and settlement period. The date must be given in the format yyyy-MM-dd.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "balancing",
                "physical",
                "all"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dataset",
                  "value": "<string>",
                  "description": "(Required) Dataset to query."
                },
                {
                  "disabled": false,
                  "key": "settlementDate",
                  "value": "<date>",
                  "description": "(Required) The settlement date for the filter."
                },
                {
                  "disabled": false,
                  "key": "settlementPeriod",
                  "value": "<integer>",
                  "description": "(Required) The settlement period for the filter. This should be an integer from 1-50 inclusive."
                },
                {
                  "disabled": false,
                  "key": "bmUnit",
                  "value": "<string>",
                  "description": "The BM Units to query. Elexon or NGC BMU IDs can be used. If omitted, results for all BM units will be returned."
                },
                {
                  "disabled": false,
                  "key": "bmUnit",
                  "value": "<string>",
                  "description": "The BM Units to query. Elexon or NGC BMU IDs can be used. If omitted, results for all BM units will be returned."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response data format. Use json/xml to include metadata."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
