          "name": "Market-wide bid-offer acceptances (BOALF)",
          "request": {
            "name": "Market-wide bid-offer acceptances (BOALF)",
            "description": {
              "content": "This endpoint provides the bid-offer acceptance data (BOALF) for multiple requested BMUs or all BMUs.\nIt returns the data valid for a single settlement period.\n            \nThe settlement period must be specified as a date and settlement period. The date parameter must be provided in the exact format yyyy-MM-dd.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "balancing",
                "acceptances",
                "all"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "settlementDate",
                  "value": "<date>",
                  "description": "(Required) The settlement date for the filter."
                },
                {
                  "disabled": false,
                  "key": "settlementPeriod",
                  "value": "<integer>",
                  "description": "(Required) The settlement period for the filter. This should be an integer from 1-50 inclusive."
                },
                {
                  "disabled": false,
                  "key": "bmUnit",
                  "value": "<string>",
                  "description": "The BM Units to query. Elexon or NGC BMU IDs can be used. If omitted, results for all BM units will be returned."
                },
                {
                  "disabled": false,
                  "key": "bmUnit",
                  "value": "<string>",
